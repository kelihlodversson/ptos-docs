---
import TableScroll from './TableScroll.astro';
import type { Register } from '../data/overlays';
interface Props { rows: Register[]; caption?: string }
const { rows, caption = 'Register assignments' } = Astro.props;
---
<TableScroll label="Register assignments">
  <table class="prm-rule-table prm-key-table">
    <caption>{caption}</caption>
    <thead><tr><th scope="col">Register</th><th scope="col">Assignment</th></tr></thead>
    <tbody>{rows.map(([reg, assignment]) => <tr><th scope="row"><code>{reg}</code></th><td>{assignment}</td></tr>)}</tbody>
  </table>
</TableScroll>
