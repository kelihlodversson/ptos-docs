---
import Layout from './Layout.astro';
import Masthead from './Masthead.astro';
import Fact from './Fact.astro';
import Availability from './Availability.astro';
import ParameterList from './ParameterList.astro';
import TargetPanels from './TargetPanels.astro';
import CallingConvention from './CallingConvention.astro';
import GfaBinding from './GfaBinding.astro';
import SourceList from './SourceList.astro';
import { historicalReference, referenceLocation, referencePath } from '../data/catalog';
import type { Historical, Source } from '../data/catalog';
import { elfEntryPath, manualBreadcrumbs } from '../data/manual-structure';
import { overlays, pexecModes } from '../data/overlays';
import translation from '../data/translation-review.json';

interface Props { name: string; record: Historical }
const { name, record } = Astro.props;
const overlay = overlays[name];
const location = referenceLocation(name);
const subsystem = location?.chapter?.name ?? 'GEMDOS';
const group = location?.group ?? subsystem;
const { title, operation } = record;
const sources: Source[] = [
  ['tos', record.path, 'Historical function and bindings'],
  ...overlay.sources,
];
---
<Layout title={name} description={operation} running={`${subsystem} — ${group}`}
  breadcrumbs={manualBreadcrumbs(location?.chapter?.slug ?? 'gemdos', location?.section?.slug)}>
  <article>
    <Masthead {name} {title} {subsystem} />
    <section aria-labelledby="prm-prototype-heading">
      <h2 id="prm-prototype-heading" class="prm-section-heading">C Prototype</h2>
      <pre class="prm-prototype"><code>{record.syntax}</code></pre>
    </section>

    <dl class="prm-facts">
      <Fact label="Operation">{operation}</Fact>
      <Fact label="Opcode">{subsystem === 'AES' ? 'Historical AES operation' : 'GEMDOS'}{' '}<code>{record.opcode} ({`0x${Number(record.opcode).toString(16).toUpperCase()}`})</code></Fact>
      <Fact label="Parameters"><ParameterList entries={overlay.params} /></Fact>
      <Fact label="Description">
        <div set:html={record.description} />
      </Fact>
      <Fact label="Return Value">
        <div set:html={record.returns} />
        {name === 'Fclose' && <p class="revision-note">The pTOS libcmini binding returns <code>long</code>. Native GEMDOS uses <code>EIHNDL</code> for an invalid handle. The historical listing uses <code>EBADF</code>.</p>}
      </Fact>
      <Fact label="Availability">
        <Availability history={record.availability} support={overlay.targets} paraTos={overlay.paraTos}>
          {name === 'Pexec' && <p>Historical version qualifications for modes 6 and 7, and MagiC restrictions, appear in the mode descriptions above.</p>}
          {name === 'appl_init' && <p>ARM and 68k builds with per-process address spaces lack kernel AES at this revision. Native libaes ports for those configurations are <strong>planned</strong> follow-ups.</p>}
        </Availability>
      </Fact>
    </dl>

    {name === 'Pexec' && <section aria-labelledby="mode-fields">
      <h2 id="mode-fields" class="prm-section-heading ruled">Parameter Fields · native pTOS modes</h2>
      <p>Use the SDK’s four-argument <code>Pexec(mode, prog, tail, env)</code> binding. The historical prototypes above describe other systems as well.</p>
      <table class="prm-rule-table">
        <thead><tr><th scope="col">Mode</th><th scope="col">Arguments after mode</th><th scope="col">Meaning</th></tr></thead>
        <tbody>{pexecModes.map(([mode, args, meaning]) => <tr><th scope="row">{mode}</th><td><code>{args}</code></td><td>{meaning}</td></tr>)}</tbody>
      </table>
      <p>On MMU ARM and x32, staged modes 3, 4, 5, 6, 7, 104 and 106 return <code>EINVFN</code> before arguments are read. Non-MMU ARM retains the legacy paths for 3–7, with compatibility unchecked.</p>
      <p>Mode 200 keeps the existing PROCESS, PID, TID, open files, current directories, parent and children. Public <code>Pexecve</code> is <strong>planned</strong> as a later API migration. <a href="https://github.com/kelihlodversson/pTOS/issues/1008">pTOS #1008</a></p>
    </section>}

    <TargetPanels>
      <CallingConvention slot="68k" binding={overlay.targets['68k']} example={record.assembly}>
        {record.legacyBinding && <div set:html={record.legacyBinding} />}
        {record.arrays && <div set:html={record.arrays} />}
        {name === 'Pexec' && <p>ROM/non-MMU 68k keeps its classic staged modes, with 104 and 106 refused. On eligible MMU builds, mode 4 and 104 require the shared-VM PRG path. Mode 200 requires <code>CONF_WITH_PEXEC200</code>.</p>}
      </CallingConvention>
      <CallingConvention slot="arm" binding={overlay.targets.arm}>
        {name === 'Pexec' && <p>On MMU ARM, modes 3, 4, 5, 6, 7, 104 and 106 are unsupported. Mode 100 needs the native scheduler. Mode 200 needs <code>CONF_WITH_PEXEC200</code>.</p>}
      </CallingConvention>
      <CallingConvention slot="x32" binding={overlay.targets.x32}>
        {name === 'Pexec' && <p>On x32, modes 3, 4, 5, 6, 7, 104 and 106 are unsupported. Mode 100 needs the native scheduler. Mode 200 needs <code>CONF_WITH_PEXEC200</code>.</p>}
        {name === 'appl_init' && <p><a href="/abi/cuis/">CUIS service ABI</a> describes the private transport used by the library.</p>}
      </CallingConvention>
      <GfaBinding slot="gfa" code={record.gfa} original={record.originalGfa} symbol={name} {subsystem}
        raw={name === 'Pexec' ? {
          routine: 'GEMDOS', opcode: 75,
          args: [{ width: 'W', operand: 'mode' }, { width: 'L', operand: 'prog' },
            { width: 'L', operand: 'tail' }, { width: 'L', operand: 'env' }],
        } : undefined} />
    </TargetPanels>

    <section aria-labelledby="related-heading">
      <h2 id="related-heading" class="prm-section-heading ruled">See Also</h2>
      <ul class="related-links">
        {record.related.map(({ label, href }) => <li><a href={historicalReference(label, href)}>{label}</a></li>)}
        {name === 'Fclose' && <li><a href={referencePath('Pexec')}>Pexec</a></li>}
        {name === 'Pexec' && <>
          <li><a href={elfEntryPath}>ELF32 process entry</a></li>
          <li><a href="/reference/pfork/">Pfork</a></li>
          <li><a href="/reference/pvfork/">Pvfork</a></li>
          <li><a href="/reference/pwaitpid/">Pwaitpid</a></li>
        </>}
        {name === 'appl_init' && <li><a href="/abi/cuis/">CUIS ABI</a></li>}
      </ul>
    </section>

    <SourceList {sources} />
    <p class="revision-note"><a href={`/source/tos.hyp/${record.path}`}>Original English and German UDO</a> ·
      <a href={historicalReference(record.name, '#source-heading')}>Full tos.hyp entry</a> ·
      Translation {record.translation === 'verified' ? 'reviewed' : 'needs review'}.
      {name === 'Pexec' && ` ${translation.Pexec.note}`}
    </p>
  </article>
</Layout>
