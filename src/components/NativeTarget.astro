---
import CallingConvention from './CallingConvention.astro';
import MemoryLayout from './MemoryLayout.astro';
import type { CPU } from '../data/targets';
import type { NativeCall } from '../data/native-calls';
import type { Binding, Register } from '../data/overlays';

interface Props { call: NativeCall; cpu: CPU }
const { call, cpu } = Astro.props;
const opcode = `0x${call.opcode.toString(16).toUpperCase()}`;
const byteOrder = cpu === '68k' ? 'Big endian' : 'Little endian';
const unavailable = call.targets?.[cpu];
let offset = 2;
const fields = [{ name: 'Opcode', offset: 0, bytes: 2, detail: opcode },
  ...call.args.map(([name, bytes, detail]) => {
    const field = { name, offset, bytes, detail };
    offset += bytes;
    return field;
  })];
const registers: Register[] = cpu === 'arm'
  ? [['R0', `Function ${opcode} on entry, result on return`],
    ...call.args.map(([name, , detail], index): Register => [`R${index + 1}`, `${name} · ${detail}`])]
  : [['RAX', `Selector (1 << 32) | ${opcode} on entry, result on return`],
    ...call.args.map(([name, , detail], index): Register => [['RDI', 'RSI', 'RDX', 'R10', 'R8', 'R9'][index], `${name} · ${detail}`])];
const conventions = {
  '68k': `Push the packed arguments and opcode, then execute TRAP #1. The result is in D0. If the call returns, remove ${offset} bytes from the user stack.`,
  arm: 'Pass the opcode and arguments in native 32-bit slots and enter with SVC #1.',
  x32: 'Use SYSCALL from ring 3. The kernel uses 64-bit register slots with 32-bit user pointers. SYSCALL clobbers RCX and R11.',
};
const binding: Binding = unavailable
  ? { status: 'unsupported', scope: 'pTOS', detail: unavailable }
  : { status: call.status ?? 'implemented', scope: 'pTOS', detail: conventions[cpu],
    registers: cpu === '68k' ? undefined : registers };
---
<CallingConvention {binding}>
  {cpu === '68k' && <MemoryLayout caption="Caller stack at TRAP #1" {fields} bytes={offset} alignment={2} {byteOrder} />}
  {call.layout && <MemoryLayout {...call.layout}
    alignment={cpu === '68k' ? call.layout.align68k ?? call.layout.alignment : call.layout.alignment} {byteOrder} />}
  <slot />
</CallingConvention>
