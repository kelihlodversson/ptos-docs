---
import { formatHistoricalTables } from '../data/format-historical-tables';
import Layout from './Layout.astro';
import Masthead from './Masthead.astro';
import Fact from './Fact.astro';
import ParameterList from './ParameterList.astro';
import TargetPanels from './TargetPanels.astro';
import GfaBinding from './GfaBinding.astro';
import SourceList from './SourceList.astro';
import NativeTarget from './NativeTarget.astro';
import { catalog, paratosSourceTree, ptosSourceTree } from '../data/catalog';
import { nativeCalls, nativePath } from '../data/native-calls';
import type { NativeCall } from '../data/native-calls';
import { manualBreadcrumbs, nativeSection } from '../data/manual-structure';
import { pages } from '../data/historical';
import historicalMerges from '../data/historical-merges.json';
import { ssystemModePath } from '../data/ssystem-modes';

interface Props { call: NativeCall }
const { call } = Astro.props;
const params: [string, string][] = call.args.map(([name, , info]) => [name, info]);
const relatedPath = (name: string) => nativeCalls.some(entry => entry.name === name && entry.embeddedInSsystem)
  ? ssystemModePath(name)
  : catalog.find(entry => entry.name === name)?.href ?? nativePath(name);
const historical = call.historical ? pages('en').find(page => page.href === call.historical) : undefined;
const merged = Object.values(historicalMerges).includes(nativePath(call.name)) ? historical : undefined;
const historicalFact = (label: string) => historical?.facts.find(fact => fact.label === label)?.value;
const historicalAvailability = historicalFact('Availability:');
---
<Layout title={call.name} description={call.title} running="GEMDOS"
  breadcrumbs={manualBreadcrumbs('gemdos', nativeSection(call.name))}>
  <article id={merged?.id}>
    <Masthead name={call.name} title={call.title} subsystem="GEMDOS" />
    <section aria-labelledby="prm-prototype-heading">
      <h2 id="prm-prototype-heading" class="prm-section-heading">C Prototype</h2>
      <pre class="prm-prototype"><code>{call.prototype}</code></pre>
      {(call.mode !== undefined || ['Pclone', 'Pthjoin'].includes(call.name)) &&
        <p class="revision-note">C call form for the documented GEMDOS ABI.</p>}
    </section>
    <dl class="prm-facts">
      <Fact label="Operation">{call.title}.</Fact>
      <Fact label="Opcode"><code>{`0x${call.opcode.toString(16).toUpperCase()}`}</code>
        {call.mode !== undefined && <> · mode <code>{call.mode}</code></>}</Fact>
      {params.length > 0 && <Fact label="Parameters"><ParameterList entries={params} /></Fact>}
      <Fact label="Description">{call.description.map(text => <p>{text}</p>)}</Fact>
      {call.modes && <Fact label="Modes"><ParameterList entries={call.modes} /></Fact>}
      <Fact label="Return Value">{call.result}</Fact>
      <Fact label="Availability">
        <p><strong>pTOS</strong> · {call.config} <a href={ptosSourceTree}>master snapshot</a></p>
        <p id="paratos"><strong>ParaTOS</strong> · {call.paraTos} <a href={paratosSourceTree}>ParaTOS main snapshot</a></p>
        {historicalAvailability && <div class="historical-availability">
          <p><strong>Historical</strong></p>
          <div set:html={formatHistoricalTables(historicalAvailability)} />
        </div>}
      </Fact>
    </dl>
    <TargetPanels>
      <NativeTarget slot="68k" {call} cpu="68k">
        {merged?.bindings?.assembly && <section class="historical-entry" aria-labelledby="historical-assembly">
          <h3 id="historical-assembly" class="prm-section-heading">Historical 68k binding</h3>
          <div set:html={formatHistoricalTables(merged.bindings.assembly)} />
        </section>}
      </NativeTarget>
      <NativeTarget slot="arm" {call} cpu="arm" />
      <NativeTarget slot="x32" {call} cpu="x32" />
      <GfaBinding slot="gfa" symbol={call.name} subsystem="GEMDOS" code={merged?.bindings?.gfa}
        raw={merged?.bindings?.raw ?? (call.status !== 'experimental' && !call.targets?.['68k'] ? {
          routine: 'GEMDOS', opcode: call.opcode,
          args: call.args.map(([operand, bytes], index) => ({
            width: bytes === 2 ? 'W' : 'L',
            operand: index === 0 && call.mode !== undefined ? `#${call.mode}` : operand,
          })),
        } : undefined)}
        discardResult={/^void\s/.test(call.prototype)} />
    </TargetPanels>
    {merged && <section class="historical-entry" aria-labelledby="historical-mint">
      <h2 id="historical-mint" class="prm-section-heading ruled">Historical MiNT reference</h2>
      <p>Historical C declaration <code>{merged.prototype}</code></p>
      <div set:html={formatHistoricalTables(historicalFact('Description:'))} />
      <h3 class="prm-section-heading">Historical return values</h3>
      <div set:html={formatHistoricalTables(historicalFact('Return value:'))} />
    </section>}
    <section aria-labelledby="related-heading">
      <h2 id="related-heading" class="prm-section-heading ruled">See Also</h2>
      <ul class="related-links">{call.related.map(name => <li><a href={relatedPath(name)}>{name}</a></li>)}</ul>
    </section>
    <SourceList sources={call.sources} />
  </article>
</Layout>
