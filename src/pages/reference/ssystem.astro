---
import Layout from '../../components/Layout.astro';
import Masthead from '../../components/Masthead.astro';
import Fact from '../../components/Fact.astro';
import Availability from '../../components/Availability.astro';
import ParameterList from '../../components/ParameterList.astro';
import TargetPanels from '../../components/TargetPanels.astro';
import CallingConvention from '../../components/CallingConvention.astro';
import GfaBinding from '../../components/GfaBinding.astro';
import MemoryLayout from '../../components/MemoryLayout.astro';
import SourceList from '../../components/SourceList.astro';
import { cookieJarPath, cookieKeysPath, manualBreadcrumbs, systemVariablesPath } from '../../data/manual-structure';
import { pages } from '../../data/historical';
import { overlays } from '../../data/overlays';
import { readSsystemHistory } from '../../data/ssystem-history';
import { ssystemDescription, ssystemModeGroups } from '../../data/ssystem-modes';
import abi from '../../data/abi.json';

const historical = pages('en').find(page => page.slug === 'ssystem');
if (!historical) throw new Error('Missing historical Ssystem entry');
const fact = (label: string) => historical.facts.find(item => item.label === label)?.value;
const { params, targets, paraTos, sources } = overlays.Ssystem;
const hex = (mode: number) => '0x' + (mode & 0xFFFF).toString(16).toUpperCase().padStart(4, '0');
const processConfig = 'https://github.com/kelihlodversson/pTOS/blob/32aaf698875f13d25c252b8e3f00d33da4f0a62d/bdos/Kconfig';
const history = readSsystemHistory(fact('Description:') ?? '');
const nativeModes = ssystemModeGroups.flatMap(group => group.modes);
const nativeByName = new Map(nativeModes.map(mode => [mode.name, mode]));
const mintModes = history.modes.map(mode => {
  const ptos = nativeByName.get(mode.name);
  if (ptos && ptos.number !== mode.number) throw new Error(`Ssystem selector mismatch for ${mode.name}`);
  return { ...mode, ptos };
});
const mintNames = new Set(mintModes.map(mode => mode.name));
const extensions = nativeModes.filter(mode => mode.number < -1)
  .map(ptos => ({ name: ptos.name, number: ptos.number, meaning: undefined, ptos }));
if (mintModes.filter(mode => mode.ptos).length + extensions.length !== nativeModes.length ||
    extensions.some(mode => mintNames.has(mode.name))) throw new Error('Unmatched pTOS Ssystem selector');
const modeSections = [
  { title: undefined, rows: mintModes },
  { title: 'pTOS extensions', rows: extensions },
];
---
<Layout title="Ssystem" description={ssystemDescription} running="GEMDOS — System functions"
  breadcrumbs={manualBreadcrumbs('gemdos', 'system-functions')}>
  <article id={historical.id}>
    <Masthead name="Ssystem" title="System queries and settings" subsystem="GEMDOS" />
    <section aria-labelledby="prm-prototype-heading">
      <h2 id="prm-prototype-heading" class="prm-section-heading">C Prototype</h2>
      <pre class="prm-prototype"><code>long Ssystem(short mode, long arg1, long arg2);</code></pre>
      <p class="prototype-note">Call signature for the SDK macro in <code>&lt;mint/mintbind.h&gt;</code>.</p>
    </section>
    <dl class="prm-facts">
      <Fact label="Operation">{ssystemDescription}</Fact>
      <Fact label="Opcode">GEMDOS <code>340 (0x0154)</code></Fact>
      <Fact label="Parameters"><ParameterList entries={params} /></Fact>
      <Fact label="Return Value">
        <p>The result depends on the mode. The dispatcher returns <code>EINVFN</code> for an unimplemented mode.
          User-address-space builds validate caller buffers and can reject an invalid address with <code>EIMBA</code>.</p>
      </Fact>
      <Fact label="Availability">
        <Availability history={fact('Availability:')} support={targets} {paraTos}>
          <p><code>CONF_WITH_SSYSTEM</code> defaults on for ARM, x32 and private address-space builds. Options such as
            the external desktop also select it on 68k. Use <code>S_INQUIRE</code> before relying on an optional mode.</p>
        </Availability>
      </Fact>
    </dl>

    <section class="historical-entry" aria-labelledby="historical-mint">
      <h2 id="historical-mint" class="prm-section-heading ruled">Ssystem modes</h2>
      <p>Query a pTOS mode with <code>Ssystem(-1, selector, 0L)</code>. A successful probe establishes that the kernel
        advertises the mode. Arguments, privileges and build features can further restrict the call.</p>
      <h3 class="prm-section-heading">Historical MiNT introduction</h3>
      <div set:html={history.intro} />
      <div id="native-modes" class="table-scroll" tabindex="0" role="region" aria-label="Ssystem mode table">
        <table class="prm-rule-table ssystem-mode-table">
          <caption>Ssystem mode reference</caption>
          <colgroup><col class="mode-number" /><col /><col class="mode-ptos" /></colgroup>
          <thead><tr><th scope="col">Mode</th><th scope="col">MiNT (historical)</th><th scope="col">pTOS</th></tr></thead>
          {modeSections.map(({ title, rows }) => <tbody>
            {title && <tr><th colspan="3" scope="rowgroup">{title}</th></tr>}
            {rows.map(({ name, number, meaning, ptos }) => <tr id={name}>
              <th scope="row">
                {ptos && <span id={`native-${name}`}></span>}
                {ptos?.href ? <a href={ptos.href}><code>{name}</code></a> : <code>{name}</code>}
                <br /><code>{number} ({hex(number)})</code>
              </th>
              {meaning !== undefined ? <td set:html={meaning} /> : <td>—</td>}
              <td>
                {ptos ? <>
                  <code>arg1 = {ptos.args[0]}</code><br /><code>arg2 = {ptos.args[1]}</code><br />
                  {ptos.result}{ptos.condition && <> {ptos.condition}</>}
                  {name === 'S_PROCEXEC' && <>
                    {' '}The current PR #903 configuration uses <code>CONF_WITH_MULTITHREADING</code> as its scheduling gate.
                    {' '}<a href={processConfig}>Configuration source</a>.
                  </>}
                  {ptos.description?.map(detail => <p class="mode-detail">{detail}</p>)}
                  {name === 'S_GETCOOKIE' && <p class="mode-detail">
                    <a href={cookieJarPath + '#ssystem-access'}>Cookie jar access guide</a> ·
                    <a href={cookieKeysPath}>Known cookie keys (Cookie and XBRA list)</a>
                  </p>}
                  {/^(S_GET|S_SET)[LWB]VAL$/.test(name) && <p class="mode-detail">
                    <a href={systemVariablesPath + '#ssystem-access'}>BIOS system variables</a>
                  </p>}
                </> : <>
                  {name === 'S_CLOCKUTC' ? 'Planned.' : 'Unimplemented.'} Returns <code>EINVFN</code>.
                </>}
              </td>
            </tr>)}
          </tbody>)}
        </table>
      </div>
      <h3 class="prm-section-heading">pTOS mode notes</h3>
      <p>The system-variable modes accept only addresses present in the kernel’s table for the requested width.
        Unknown addresses return <code>EINVFN</code>. See the linked dispatcher source for the accepted addresses.</p>
      <p><code>S_CONSOLE_DIM</code>, <code>S_MEMINFO</code>, <code>S_DESKINFO</code> and <code>S_MMUPROBE</code> use
        the smaller of the supplied length and the kernel structure size. Check the returned byte count before using a field.
        A size of <code>-1</code> queries the structure size and ignores the buffer. A null buffer or a nonpositive size
        outside the query form is invalid.</p>
      <h3 class="prm-section-heading">Historical MiNT notes</h3>
      <div set:html={history.notes} />
    </section>

    <TargetPanels>
      <CallingConvention slot="68k" binding={targets['68k']}>
        <div class="historical-entry" set:html={historical.bindings?.assembly} />
        <MemoryLayout {...abi.console} byteOrder="Big endian" />
      </CallingConvention>
      <CallingConvention slot="arm" binding={targets.arm}>
        <MemoryLayout {...abi.console} byteOrder="Little endian" />
      </CallingConvention>
      <CallingConvention slot="x32" binding={targets.x32}>
        <MemoryLayout {...abi.console} byteOrder="Little endian" />
      </CallingConvention>
      <GfaBinding slot="gfa" symbol="Ssystem" subsystem="GEMDOS" code={historical.bindings?.gfa} raw={historical.bindings?.raw} />
    </TargetPanels>

    <section aria-labelledby="related-heading">
      <h2 id="related-heading" class="prm-section-heading ruled">See Also</h2>
      <ul class="related-links">
        <li><a href="/historical/en/sysconf/">Sysconf</a></li>
        <li><a href="/historical/en/tgettimeofday/">Tgettimeofday</a></li>
        <li><a href="/historical/en/tsettimeofday/">Tsettimeofday</a></li>
      </ul>
    </section>
    <SourceList sources={[[ 'tos', historical.path, 'Original tos.hyp Ssystem description and binding' ], ...sources]} />
  </article>
</Layout>

<style>
  .ssystem-mode-table { table-layout: fixed; min-width: 44rem; }
  .mode-number { width: 9.5rem; }
  .mode-ptos { width: 34%; }
  .mode-detail { margin: .5rem 0 0; }
  @media print {
    .ssystem-mode-table { min-width: 0; }
    .mode-number { width: 7rem; }
    .ssystem-mode-table > tbody > tr { break-inside: auto; }
  }
</style>
