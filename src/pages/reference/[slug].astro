---
import ReferenceLeaf from '../../components/ReferenceLeaf.astro';
import NativeReference from '../../components/NativeReference.astro';
import { historical } from '../../data/catalog';
import type { Historical } from '../../data/catalog';
import { nativeCalls, nativePath } from '../../data/native-calls';
import type { NativeCall } from '../../data/native-calls';

export function getStaticPaths() {
  return [
    ...Object.values(historical).map(record => ({
      params: { slug: record.name.toLowerCase() }, props: { name: record.name, record, native: null },
    })),
    { params: { slug: 'ssystem' }, props: { name: 'Ssystem', record: null, native: null } },
    ...nativeCalls.map(native => ({
      params: { slug: nativePath(native.name).split('/')[2] }, props: { name: native.name, record: null, native },
    })),
  ];
}

interface Props { name: string; record: Historical | null; native: NativeCall | null }
const { name, record, native } = Astro.props;
---
{native ? <NativeReference call={native} /> : <ReferenceLeaf {name} {record} />}
