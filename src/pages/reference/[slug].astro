---
import ReferenceLeaf from '../../components/ReferenceLeaf.astro';
import NativeReference from '../../components/NativeReference.astro';
import CuisReference from '../../components/CuisReference.astro';
import HistoricalRedirect from '../../components/HistoricalRedirect.astro';
import { historical } from '../../data/catalog';
import type { Historical } from '../../data/catalog';
import { nativeCalls, nativePath } from '../../data/native-calls';
import type { NativeCall } from '../../data/native-calls';
import { cuisCallPath, cuisGroups } from '../../data/cuis-calls';
import type { CuisCall, CuisGroup } from '../../data/cuis-calls';

export function getStaticPaths() {
  return [
    ...Object.values(historical).map(record => ({
      params: { slug: record.name.toLowerCase() }, props: { record },
    })),
    ...nativeCalls.map(native => ({
      params: { slug: nativePath(native.name).split('/')[2] }, props: { native },
    })),
    ...cuisGroups.flatMap(({ calls, slug, title }) => calls.map(call => ({
      params: { slug: cuisCallPath(call.name).split('/')[2] }, props: { cuis: { call, group: { slug, title } } },
    }))),
  ];
}

type Props = { record: Historical; native?: never; cuis?: never }
  | { native: NativeCall; record?: never; cuis?: never }
  | { cuis: { call: CuisCall; group: Pick<CuisGroup, 'slug' | 'title'> }; native?: never; record?: never };
const { record, native, cuis } = Astro.props;
---
{cuis ? <CuisReference {...cuis} /> : native?.embeddedInSsystem
  ? <HistoricalRedirect name={native.name} destination={`/reference/ssystem/#${native.name}`} />
  : native ? <NativeReference call={native} /> : <ReferenceLeaf name={record.name} {record} />}
