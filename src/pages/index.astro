---
import Layout from '../components/Layout.astro';
import CatalogList from '../components/CatalogList.astro';
import { catalog } from '../data/catalog';
import { chapters } from '../data/manual-structure';
---
<Layout title="Programmer’s Reference Manual" description="The pTOS and ParaTOS programmer’s reference for GEMDOS, AES and native ABI.">
  <header class="directory-head">
    <h1>Programmer’s<br />Reference Manual</h1>
    <p>API and ABI reference for pTOS and ParaTOS, with historical TOS documentation from <em>tos.hyp</em>.</p>
  </header>
  <section aria-labelledby="reference-entries">
    <h2 class="ruled prm-section-heading" id="reference-entries">Reference Entries</h2>
    <CatalogList records={catalog.filter(entry => entry.href.startsWith('/reference/') || entry.href.startsWith('/abi/')).slice(0, 10)} />
    <p><a href="/functions/">Browse the function index</a></p>
  </section>
  <section aria-labelledby="subsystem-heading">
    <h2 class="ruled prm-section-heading" id="subsystem-heading">Subsystems</h2>
    <ul class="manual-index">{chapters.map(({ name, href }) => <li><a class="manual-index-symbol" href={href}>{name}</a></li>)}</ul>
  </section>
</Layout>
