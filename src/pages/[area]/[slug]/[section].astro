---
import { formatHistoricalTables } from '../../../data/format-historical-tables';
import Layout from '../../../components/Layout.astro';
import CatalogList from '../../../components/CatalogList.astro';
import ManualIntroduction from '../../../components/ManualIntroduction.astro';
import BiosCookieJar from '../../../components/BiosCookieJar.astro';
import BiosSystemVariables from '../../../components/BiosSystemVariables.astro';
import GemdosProgramFormat from '../../../components/GemdosProgramFormat.astro';
import GemdosProgramLaunch from '../../../components/GemdosProgramLaunch.astro';
import GemdosSignals from '../../../components/GemdosSignals.astro';
import { catalog } from '../../../data/catalog';
import { chapters, cookieJarPath, historicalSectionBody, legacyGemdosSectionSlugs, manualBreadcrumbs, systemVariablesPath } from '../../../data/manual-structure';

export function getStaticPaths() {
  return chapters.flatMap(chapter => chapter.sections.filter(section => !section.standalone).map(section => ({
    params: { area: chapter.area.slug, slug: chapter.slug, section: section.slug }, props: { chapter, section },
  })));
}
interface Props {
  chapter: typeof chapters[number];
  section: typeof chapters[number]['sections'][number];
}
const { chapter, section } = Astro.props;
const entries = catalog.filter(entry => entry.chapter?.slug === chapter.slug && entry.section?.slug === section.slug);
const programFormat = chapter.slug === 'gemdos' && section.slug === 'the-program-format';
const programLaunch = chapter.slug === 'gemdos' && section.slug === 'program-launch-and-tpa';
const programTopic = programFormat || programLaunch;
const prgSectionId = programFormat ? 'prg-format' : 'prg-startup';
const prgSectionTitle = programFormat ? 'Classic GEMDOS PRG format' : 'Classic GEMDOS PRG startup';
const cookieJar = section.href === cookieJarPath;
const signals = chapter.slug === 'gemdos' && section.slug === 'signals';
const legacyExtensions = chapter.slug === 'gemdos' && section.slug === 'legacy-extensions';
const legacySection = chapter.slug === 'gemdos' && legacyGemdosSectionSlugs.includes(section.slug);
const legacyTopics = legacyExtensions ? chapter.sections.filter(topic => legacyGemdosSectionSlugs.includes(topic.slug)) : [];
const historicalBody = section.historicalSlug ? historicalSectionBody(section.historicalSlug) ?? '' : '';
const HistoricalBody = section.href === systemVariablesPath ? BiosSystemVariables : signals ? GemdosSignals : undefined;
---
<Layout title={section.name} description={`${section.name} in the ${chapter.name} chapter.`} running={chapter.name}
  breadcrumbs={manualBreadcrumbs(chapter.slug, legacySection ? 'legacy-extensions' : undefined)}>
  <header class="directory-head"><h1>{section.name}</h1></header>
  <ManualIntroduction subject={section.slug} />
  {legacyExtensions && <>
    <p>Historical GEMDOS extensions for older network drivers, multitasking libraries and add-on hardware.</p>
    <ul class="manual-index">
      {legacyTopics.map(topic => <li><a class="manual-index-symbol" href={topic.href}>{topic.name}</a></li>)}
    </ul>
  </>}
  {chapter.slug === 'gemdos' && section.slug === 'network-functions' &&
    <p>File flushing, file locking and driver identification for older TOS network drivers.</p>}
  {programFormat && <p>On m68k, pTOS supports ELF executables and legacy GEMDOS PRG programs when their loaders are enabled.
    On ARM and x32, pTOS can run compatible 68k PRG binaries through ParaTOS when configured as an executable handler.</p>}
  {programLaunch && <p>pTOS uses <a href="/reference/pexec/">Pexec</a> to load and start programs. On m68k, it can launch ELF
    and classic GEMDOS PRG programs when their loaders are enabled. Classic PRG startup places a basepage in the program’s
    Transient Program Area (TPA). On ARM and x32, pTOS can launch compatible 68k PRG binaries through ParaTOS.</p>}
  {programTopic && <nav aria-label={programFormat ? 'Program formats' : 'Program startup'}>
    <ul class="related-links">
      <li><a href={programFormat ? '#elf-executables' : '#elf-startup'}>{programFormat ? 'ELF executables' : 'ELF startup and memory'}</a></li>
      <li><a href={`#${prgSectionId}`}>{prgSectionTitle}</a></li>
    </ul>
  </nav>}
  {programFormat && <GemdosProgramFormat />}
  {programLaunch && <GemdosProgramLaunch />}
  {programTopic && <h2 id={prgSectionId} class="prm-section-heading ruled">{prgSectionTitle}</h2>}
  {cookieJar && <BiosCookieJar />}
  {cookieJar && <h2 class="prm-section-heading ruled">Classic TOS cookie jar</h2>}
  {section.historicalSlug && (entries.length === 0 || section.slug === 'xcontrol') &&
    (HistoricalBody
      ? <HistoricalBody {historicalBody} />
      : <div class:list={['historical-body', { 'historical-entry': programTopic || cookieJar }]} set:html={formatHistoricalTables(historicalBody)} />)}
  {entries.length > 0 && <CatalogList records={entries} showSubsystem={false} />}
</Layout>
