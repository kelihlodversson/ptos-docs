---
import { formatHistoricalTables } from '../../../data/format-historical-tables';
import Layout from '../../../components/Layout.astro';
import Masthead from '../../../components/Masthead.astro';
import Fact from '../../../components/Fact.astro';
import TargetPanels from '../../../components/TargetPanels.astro';
import GfaBinding from '../../../components/GfaBinding.astro';
import HistoricalNativeTarget from '../../../components/HistoricalNativeTarget.astro';
import HistoricalPtosAvailability from '../../../components/HistoricalPtosAvailability.astro';
import HistoricalRedirect from '../../../components/HistoricalRedirect.astro';
import SourceList from '../../../components/SourceList.astro';
import { pages } from '../../../data/historical';
import { importedNavigation } from '../../../data/manual-structure';
import type { HistoricalPage } from '../../../data/historical';
import historicalMerges from '../../../data/historical-merges.json';

export function getStaticPaths() {
  return (['en', 'de'] as const).flatMap(language => pages(language).map(page => ({
    params: { language, slug: page.slug },
    props: { page },
  })));
}

interface Props { page: HistoricalPage }
const { page } = Astro.props;
const english = page.language === 'en';
const description = page.description || page.title;
const { chapter, breadcrumbs } = importedNavigation(page);
const availability = page.function ? page.facts.findIndex(({ label }) => /^(Availability|Verfügbar):?$/.test(label)) : -1;
const destination = (historicalMerges as Record<string, string>)[page.slug];
---
{destination ? <HistoricalRedirect name={page.title} {destination} /> :
<Layout title={page.title} {description} running={chapter?.name ?? page.subsystem} {breadcrumbs}>
  <article class="historical-entry" lang={page.language}>
    {page.function ? <div id={page.id}><Masthead name={page.title} title={page.operation} subsystem={chapter?.name ?? page.subsystem} /></div>
      : <header class="directory-head"><h1 id={page.id}>{page.title}</h1></header>}
    {page.prototype && <section aria-labelledby="prm-prototype-heading">
      <h2 id="prm-prototype-heading" class="prm-section-heading">{english ? 'C Prototype' : 'C-Deklaration'}</h2>
      <pre class="prm-prototype"><code>{page.prototype}</code></pre>
    </section>}
    {page.native && <p class="revision-note"><a href={page.native}>{english ? 'pTOS and ParaTOS implementation notes' : 'Hinweise zur pTOS- und ParaTOS-Implementierung'}</a></p>}
    {(page.facts.length > 0 || page.function) && <dl class="prm-facts">
      {page.facts.map(({ label, value }, index) => <Fact label={label.replace(/:$/, '')}>
        <div set:html={formatHistoricalTables(value, page.language)} />
        {index === availability && <HistoricalPtosAvailability {page} history={value} />}
      </Fact>)}
      {page.function && availability < 0 && <Fact label={english ? 'Availability' : 'Verfügbar'}>
        <HistoricalPtosAvailability {page} />
      </Fact>}
    </dl>}
    {english && page.slug === 'shel-write' && <section aria-labelledby="ptos-launch">
      <h2 id="ptos-launch" class="prm-section-heading ruled">Launching from x32 libaes</h2>
      <p><code>SWM_LAUNCHACC</code> (3) starts an ELF accessory with any filename. <code>SWM_LAUNCH</code> (0)
        infers the role from the extension, so a <code>.ACC</code> file starts as an accessory.
        <code>SWM_LAUNCHNOW</code> (1) selects program startup even for a <code>.ACC</code> file.
        See <a href="/os-variants/ptos/elf-entry/#startup-role">ELF program and accessory startup</a> for the CRT contract.</p>
      <p>Modes 0 and 3 default to the executable directory and send one <code>CH_EXIT</code> on child exit.
        Both accept <code>SW_DEFDIR</code> and <code>SW_ENVIRON</code> with a <code>SHELW</code> request.
        Use <code>CL_NORMAL</code> for a classic counted tail. <code>CL_PARSE</code> also accepts byte 127 followed by
        a NUL-terminated command string. Tail marker 127 with <code>CL_NORMAL</code> and the MagiC byte-255 shortcut
        return zero. Use <a href="/reference/shel-writeve/">shel_writeve</a> for explicit vectors.</p>
      <SourceList sources={[
        ['ptos', 'lib/aes/shell.c', 'x32 shell mode handling'],
        ['ptos', 'doc/libaes-shell-compatibility.md', 'Compatibility and launch mode details'],
        ['ptos', 'tests/cuis/shell.c', 'Shell launch role coverage'],
      ]} />
    </section>}
    {english && page.slug === 'shel-read' && <p>On pTOS x32, libaes returns a classic view of a vector launch when the
      operands can be quoted into a tail of at most 126 bytes. Otherwise it returns zero and preserves the buffers.
      Use <a href="/reference/shel-readve/">shel_readve</a> to read the original vectors.</p>}
    {page.body && <div class="historical-body" set:html={formatHistoricalTables(page.body, page.language)} />}
    {page.function && <TargetPanels heading={english ? 'Calling Convention' : 'Aufrufkonvention'}>
      <div slot="68k">
        {page.bindings?.assembly ? <div set:html={formatHistoricalTables(page.bindings.assembly, page.language)} /> : <p>{english ? 'See the historical entry for available bindings.' : 'Siehe den historischen Eintrag für vorhandene Bindungen.'}</p>}
        {page.bindings && <a href={page.bindings.href}>{english ? 'Binding details' : 'Aufrufdetails'}</a>}
      </div>
      <HistoricalNativeTarget slot="arm" {page} cpu="arm" />
      <HistoricalNativeTarget slot="x32" {page} cpu="x32" />
      <GfaBinding slot="gfa" code={page.bindings?.gfa} raw={page.bindings?.raw} symbol={page.title}
        subsystem={page.subsystem} discardResult={/^void\s/.test(page.prototype)} language={page.language} />
    </TargetPanels>}
    <nav class="historical-nav" aria-label={english ? 'Reference navigation' : 'Navigation im Handbuch'}>
      {page.nav.map(item => <a href={item.href}>{item.label}</a>)}
    </nav>
  </article>
</Layout>
}
