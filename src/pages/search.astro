---
import Layout from '../components/Layout.astro';
import CatalogList from '../components/CatalogList.astro';
import { catalog } from '../data/catalog';
import { pages } from '../data/historical';
import { chapters } from '../data/manual-structure';

const catalogHrefs = new Set(catalog.map(entry => entry.href));
const topics = chapters.flatMap(chapter => [chapter, ...chapter.sections].map(topic => ({
  ...topic, subsystem: chapter.name, group: chapter.area.name,
})));
const listedSources = new Set(topics.map(topic => topic.historicalSlug));
const sections = pages('en').filter(page => !page.function && !listedSources.has(page.slug) && page.slug !== 'xcontrol').map(page => ({
  name: page.title, description: '', subsystem: page.subsystem, group: page.group, href: page.href,
}));
const index = [...catalog, ...topics.filter(topic => !catalogHrefs.has(topic.href)).map(topic => ({
  ...topic, description: '',
})), ...sections];
---
<Layout title="Search" description="Search pTOS functions or the original tos.hyp manual by symbol, operation or section title.">
  <header class="directory-head"><h1>Search</h1></header>
  <noscript><p>Use your browser’s Find command to search the entries below.</p></noscript>
  <div class="site-search" hidden>
    <label for="search">Function, operation or section</label>
    <input id="search" type="search" autocomplete="off" />
    <p id="search-status" role="status"></p>
  </div>
  <CatalogList records={index} searchable />
</Layout>
<script>
  const input = document.querySelector<HTMLInputElement>('#search');
  const status = document.querySelector<HTMLElement>('#search-status');
  const records = [...document.querySelectorAll<HTMLElement>('[data-search-record]')];

  function filter(query: string) {
    const tokens = query.toLowerCase().trim().split(/\s+/);
    let matches = 0;
    const displayLimit = 60;
    for (const record of records) {
      const text = record.dataset.searchRecord?.toLowerCase() ?? '';
      const found = tokens.every(token => text.includes(token));
      if (found) matches++;
      record.hidden = !found || matches > displayLimit;
    }
    if (status) status.textContent = matches > displayLimit
      ? `Showing ${displayLimit} of ${matches} entries. Narrow your search to see more.`
      : `${matches} ${matches === 1 ? 'entry' : 'entries'}`;
  }

  if (input) {
    document.querySelector<HTMLElement>('.site-search')?.removeAttribute('hidden');
    input.addEventListener('input', () => filter(input.value));
    filter(input.value);
  }
</script>
